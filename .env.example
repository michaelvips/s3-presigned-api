# Example environment variables for s3-presigned-api
# Do NOT commit real credentials to source control.

AWS_ACCESS_KEY_ID=AKIA_TEST_ACCESS_KEY_1234
AWS_SECRET_ACCESS_KEY=TEST_SECRET_KEY_1234567890abcdef1234567890abcd
AWS_REGION=us-east-1
PORT=8000
# Default expiration for generated URLs (seconds)
DEFAULT_EXPIRES=3600
# Optional: custom S3 endpoint (for MinIO, LocalStack, etc.)
# e.g. http://host.docker.internal:9000 or http://localstack:4566
S3_ENDPOINT_URL=
S3_ADDRESSING_STYLE=
# Optional: estilo de endereçamento S3 usado pelo cliente para assinar URLs.
# Valores possíveis:
# - virtual : estilo virtual-hosted (bucket como subdomínio). Padrão do S3 da AWS.
# - path    : estilo path (bucket na parte do caminho da URL). Útil para MinIO,
#             LocalStack ou quando o nome do bucket contém pontos (evita
#             problemas com certificados HTTPS).
# Deixe em branco para usar o comportamento padrão do boto3/botocore.
